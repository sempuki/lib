load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:copts.bzl", "COPTS")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "testing",
    srcs = ["testing.cpp"],
    hdrs = ["testing.hpp"],
    copts = COPTS,
    # Keep the self-registering SummaryReporter even though nothing names it.
    alwayslink = True,
    deps = [
        "@catch2",
        "@catch2//:catch2_main",
    ],
)

cc_library(
    name = "core",
    hdrs = ["core.hpp"],
    copts = COPTS,
)

cc_test(
    name = "core_test",
    size = "small",
    srcs = ["core_test.cpp"],
    copts = COPTS,
    deps = [
        ":core",
        ":testing",
    ],
)

cc_library(
    name = "contract",
    hdrs = ["contract.hpp"],
    copts = COPTS,
)

cc_test(
    name = "contract_test",
    size = "small",
    srcs = ["contract_test.cpp"],
    copts = COPTS,
    deps = [
        ":contract",
        ":testing",
    ],
)

cc_library(
    name = "status",
    hdrs = ["status.hpp"],
    copts = COPTS,
    deps = [":core"],
)

cc_test(
    name = "status_test",
    size = "small",
    srcs = ["status_test.cpp"],
    copts = COPTS,
    deps = [
        ":status",
        ":testing",
    ],
)

# platform_status.cpp is unfinished (no header yet) and is deliberately not
# built.

cc_library(
    name = "math",
    hdrs = ["math.hpp"],
    copts = COPTS,
    deps = ["@eigen"],
)

cc_test(
    name = "math_test",
    size = "small",
    srcs = ["math_test.cpp"],
    copts = COPTS,
    deps = [
        ":math",
        ":testing",
    ],
)

cc_library(
    name = "time",
    hdrs = ["time.hpp"],
    copts = COPTS,
)

cc_test(
    name = "time_test",
    size = "small",
    srcs = ["time_test.cpp"],
    copts = COPTS,
    deps = [
        ":testing",
        ":time",
    ],
)
